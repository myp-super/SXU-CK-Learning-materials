# -------------------------------------------------------------------------- #
# Quartus II Settings File for Scheme 1 (方案一)
# 二进制计数器 + bin2bcd + seg7 方案
# -------------------------------------------------------------------------- #

set_global_assignment -name FAMILY "Cyclone III"
set_global_assignment -name DEVICE AUTO
set_global_assignment -name TOP_LEVEL_ENTITY clock_top_scheme1
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name LAST_QUARTUS_VERSION 13.1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# ==================== 方案一特有源文件 ====================
set_global_assignment -name VHDL_FILE clock_top_scheme1.vhd
set_global_assignment -name VHDL_FILE count_sec_bin.vhd
set_global_assignment -name VHDL_FILE count_min_bin.vhd
set_global_assignment -name VHDL_FILE count_hour_bin.vhd
set_global_assignment -name VHDL_FILE bin2bcd.vhd
set_global_assignment -name VHDL_FILE seg7_decoder.vhd
set_global_assignment -name VHDL_FILE time_adjust.vhd
set_global_assignment -name VHDL_FILE clear_debounce.vhd

# ==================== 复用方案二的通用模块 ====================
set_global_assignment -name VHDL_FILE ../digitalClock/diver.vhd
set_global_assignment -name VHDL_FILE ../digitalClock/mux21a.vhd
set_global_assignment -name VHDL_FILE ../digitalClock/mmux21a.vhd
set_global_assignment -name VHDL_FILE ../digitalClock/switch.vhd
set_global_assignment -name VHDL_FILE ../digitalClock/trigger.vhd
set_global_assignment -name VHDL_FILE ../digitalClock/baoshi.vhd
set_global_assignment -name VHDL_FILE ../digitalClock/alarm.vhd

# ==================== 综合与仿真设置 ====================
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name SIMULATION_MODE FUNCTIONAL
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_simulation

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name VECTOR_WAVEFORM_FILE Waveform.vwf
set_global_assignment -name EDA_NETLIST_WRITER_OUTPUT_DIR "C:/Users/Lenovo/Desktop/shudiankeshe/scheme1/simulation/qsim/" -section_id eda_simulation
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation