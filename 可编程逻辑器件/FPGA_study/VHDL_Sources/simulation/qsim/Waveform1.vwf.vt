module Traffic_Light_Top_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk_50MHz;
reg reset_n;
reg vehicle_detected;
// wires                                               
wire branch_green;
wire branch_red;
wire branch_yellow;
wire main_green;
wire main_red;
wire main_yellow;
wire [6:0] seg_high;
wire [6:0] seg_low;

wire sampler;                             

// assign statements (if any)                          
Traffic_Light_Top i1 (
// port map - connection between master ports and signals/registers   
	.branch_green(branch_green),
	.branch_red(branch_red),
	.branch_yellow(branch_yellow),
	.clk_50MHz(clk_50MHz),
	.main_green(main_green),
	.main_red(main_red),
	.main_yellow(main_yellow),
	.reset_n(reset_n),
	.seg_high(seg_high),
	.seg_low(seg_low),
	.vehicle_detected(vehicle_detected)
);

// clk_50MHz
always
begin
	clk_50MHz = 1'b0;
	clk_50MHz = #10000 1'b1;
	#10000;
end 

// reset_n
initial
begin
	reset_n = 1'b0;
	reset_n = #200000 1'b1;
end 

// vehicle_detected
initial
begin
	vehicle_detected = 1'b0;
	vehicle_detected = #220000 1'b1;
	vehicle_detected = #10000 1'b0;
	vehicle_detected = #50000 1'b1;
	vehicle_detected = #10000 1'b0;
end 

Traffic_Light_Top_vlg_sample_tst tb_sample (
	.clk_50MHz(clk_50MHz),
	.reset_n(reset_n),
	.vehicle_detected(vehicle_detected),
	.sampler_tx(sampler)
);

Traffic_Light_Top_vlg_check_tst tb_out(
	.branch_green(branch_green),
	.branch_red(branch_red),
	.branch_yellow(branch_yellow),
	.main_green(main_green),
	.main_red(main_red),
	.main_yellow(main_yellow),
	.seg_high(seg_high),
	.seg_low(seg_low),
	.sampler_rx(sampler)
);
endmodule

